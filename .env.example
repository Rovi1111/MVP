# Скопируйте в .env и поменяйте значения
DATABASE_URL=sqlite:///./data/app.db
# Для PostgreSQL: DATABASE_URL=postgresql+psycopg://user:pass@localhost/expenses
SECRET_KEY=замените-на-длинную-случайную-строку
COOKIE_SECURE=false
AUTH_PROVIDER=local

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=300

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
